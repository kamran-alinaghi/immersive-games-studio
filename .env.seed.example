# Firebase project used by the local emulator seed scripts
FIREBASE_PROJECT_ID=immersive-game-studio

# Local emulator endpoints only. Do not change these to production endpoints.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081

# Local administrator account created in the Auth emulator
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-strong-local-password
ADMIN_NAME=Local Administrator

# JSON file containing local test registrations (relative to repository root)
SEED_REGISTRATIONS_FILE=seed-registrations.json
