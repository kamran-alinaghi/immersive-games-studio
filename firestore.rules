rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Admin status is provisioned out-of-band by the project owner.
    match /admins/{adminUid} {
      allow get: if signedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    // Applicant data is private. Administrators may read it; all mutations
    // are performed by trusted Cloud Functions using the Admin SDK.
    match /registrations/{registrationId} {
      allow get, list: if isActiveAdmin();
      allow create, update, delete: if false;
    }

    // Rate-limit metadata must never be readable or writable by clients.
    match /_registrationRateLimits/{documentId} {
      allow read, write: if false;
    }

    // Deny access to all other collections until explicit rules are added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}