rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isActiveAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{adminUid} {
      allow get: if signedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }
    match /registrations/{registrationId} {
      allow get, list: if isActiveAdmin();
      allow create, update, delete: if false;
    }
    match /players/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isActiveAdmin() || (resource.data.teamId != null && resource.data.teamId == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.teamId));
      allow list: if isActiveAdmin();
      allow create, update, delete: if false;
    }
    match /quests/{questId} {
      allow get, list: if signedIn();
      allow write: if false;
    }
    match /questAssignments/{assignmentId} {
      allow get, list: if isActiveAdmin()
        || (signedIn() && resource.data.playerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /teams/{teamId} {
      allow get: if isActiveAdmin()
        || (signedIn() && request.auth.uid in resource.data.memberUids);
      allow list: if isActiveAdmin();
      allow write: if false;
    }
    match /teamSuggestions/{suggestionId} {
      allow get, list: if isActiveAdmin()
        || (signedIn() && (
          resource.data.suggestedByUid == request.auth.uid
          || resource.data.suggestedPlayerUid == request.auth.uid
        ));
      allow write: if false;
    }
    match /videos/{videoId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isActiveAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.playerId == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.playerId
        && request.resource.data.keys().hasOnly(['uid','playerId','name','size','contentType','storagePath','createdAt'])
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 262144000
        && request.resource.data.contentType in ['video/mp4','video/quicktime','video/webm']
        && request.resource.data.storagePath.matches('players/' + request.auth.uid + '/videos/.*');
      allow update: if isActiveAdmin();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isActiveAdmin());
    }
    match /_registrationRateLimits/{documentId} { allow read, write: if false; }
    match /_registrationEmails/{documentId} { allow read, write: if false; }
    match /_playerLoginRateLimits/{documentId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}