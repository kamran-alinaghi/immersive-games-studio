# Public URL of the server-side endpoint that validates and stores registration submissions.
# This must be an HTTPS endpoint. Do not put database credentials or secrets in VITE_ variables.
VITE_REGISTRATION_API_URL=

# Firebase web app configuration (Firebase Console > Project settings > Your apps).
# These values are public client configuration, not service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=immersive-game-studio
VITE_FIREBASE_APP_ID=
